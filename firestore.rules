// Prototype for review; not deployed. Standard Firestore, default database.
// members/{uid}: active(bool), role(admin|editor|auditor), provisioned by an administrator.
// workspaces/planifica: revision(int), payload(JSON string <=700kB), operationId(string),
// payloadHash(SHA256 hex), updatedBy(uid), updatedAt(server timestamp).
// workspaces/planifica/events/{operationId}: actorUid, revision, payloadHash, createdAt.
// Each snapshot write requires its immutable event in the same transaction.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function isMember() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role in ['admin', 'editor', 'auditor'];
    }
    function canWrite() {
      return isMember() && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role in ['admin', 'editor'];
    }
    function validHash(hash) { return hash is string && hash.size() == 64 && hash.matches('^[a-f0-9]+$'); }
    function validSnapshot(data) {
      return data.keys().hasAll(['revision','payload','operationId','payloadHash','updatedBy','updatedAt'])
        && data.keys().hasOnly(['revision','payload','operationId','payloadHash','updatedBy','updatedAt'])
        && data.revision is int && data.revision > 0 && data.revision < 2147483647
        && data.payload is string && data.payload.size() > 0 && data.payload.size() <= 700000
        && data.operationId is string && data.operationId.size() > 0 && data.operationId.size() <= 100
        && validHash(data.payloadHash)
        && data.updatedBy is string && data.updatedBy.size() <= 128 && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time;
    }
    function validEvent(data) {
      return data.keys().hasAll(['revision','payloadHash','actorUid','createdAt'])
        && data.keys().hasOnly(['revision','payloadHash','actorUid','createdAt'])
        && data.revision is int && data.revision > 0 && data.revision < 2147483647
        && validHash(data.payloadHash)
        && data.actorUid is string && data.actorUid.size() <= 128 && data.actorUid == request.auth.uid
        && data.createdAt == request.time;
    }
    function hasEvent(data) {
      let path = /databases/$(database)/documents/workspaces/planifica/events/$(data.operationId);
      let event = getAfter(path).data;
      return !exists(path) && event.revision == data.revision
        && event.payloadHash == data.payloadHash && event.actorUid == data.updatedBy && event.createdAt == request.time;
    }
    match /members/{uid} {
      allow get: if isAuthenticated() && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /workspaces/planifica {
      allow get: if isMember();
      allow list, delete: if false;
      allow create: if canWrite() && validSnapshot(request.resource.data) && request.resource.data.revision == 1 && hasEvent(request.resource.data);
      allow update: if canWrite() && validSnapshot(request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1 && hasEvent(request.resource.data);
      match /events/{operationId} {
        allow read: if isMember();
        allow update, delete: if false;
        allow create: if canWrite() && operationId.size() > 0 && operationId.size() <= 100
          && validEvent(request.resource.data)
          && getAfter(/databases/$(database)/documents/workspaces/planifica).data.operationId == operationId
          && getAfter(/databases/$(database)/documents/workspaces/planifica).data.revision == request.resource.data.revision
          && getAfter(/databases/$(database)/documents/workspaces/planifica).data.payloadHash == request.resource.data.payloadHash
          && getAfter(/databases/$(database)/documents/workspaces/planifica).data.updatedBy == request.auth.uid
          && getAfter(/databases/$(database)/documents/workspaces/planifica).data.updatedAt == request.time;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
